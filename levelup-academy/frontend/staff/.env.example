# ── LOCAL DEV ──
# По умолчанию фронт ходит на БОЕВОЙ бэкенд (api.levelup-academy.uz) —
# НИЧЕГО настраивать не нужно. Просто: npm install && npm run dev →
# вход и данные работают (боевая база, реальный тестовый набор аккаунтов).
#
# Только если ты BACKEND-разработчик и поднял бэк локально на :4000 —
# раскомментируй (с 2026-07-29 localhost:4000 сам подключён к той же
# облачной базе, так что разницы в данных всё равно нет, только адрес другой):
# DEV_API_PROXY=http://localhost:4000

# Работать с настоящим бэкендом, а не с mock-данными в localStorage:
VITE_USE_MOCKS=false

# Ключ Яндекс.Карт (JavaScript API 3.0) — для выбора точки филиала на карте.
# Публичный по своей природе (виден в бандле браузера), защищён ограничением
# по HTTP referer в кабинете разработчика — не секрет, можно взять готовый:
VITE_YANDEX_KEY=c9a4e0e5-af78-44b9-ac5f-f112ab893d0a

# QR-вход студента (StudentDetail.jsx): камера телефона открывает эту ссылку,
# поэтому "localhost" не подходит — нужен LAN IP этого компа (см. `ipconfig`).
# Без этой переменной фолбэк — прод-домен member.levelup-academy.uz.
# VITE_MEMBER_URL=http://192.168.1.50:5175
