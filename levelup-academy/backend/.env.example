# --- Core ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug

# --- PostgreSQL ---
# Локально (docker): строка ниже, DB_SSL=false.
# Общий Neon: DATABASE_URL=postgres://USER:PASS@HOST/DB?sslmode=require  + DB_SSL=true
DATABASE_URL=postgres://levelup:levelup@localhost:5432/levelup
DB_SSL=false

# --- Redis ---
# Локально (docker): строка ниже. Общий Redis Cloud: redis://default:PASS@HOST:PORT
REDIS_URL=redis://localhost:6379

# --- Auth (secret shared with auth module; payload: { sub, role, orgId, branchId }) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=levelup

# --- SMTP (Mailpit in dev: web UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@levelup.local

# --- SMS provider (empty in dev — messages are logged instead of sent) ---
SMS_API_URL=
SMS_API_TOKEN=

# --- Telegram bot (optional in dev — worker skips TG delivery if empty) ---
# TELEGRAM_BOT_USERNAME нужен для deep-link привязки И входа через Telegram.
# Без него /api/telegram/bind-token и /login/start отвечают 503, кнопки прячутся.
# Пример: @levelup_academy_bot -> levelup_academy_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Оба заданы -> бот работает через webhook, иначе long-polling.
# На Render polling нежизнеспособен: он жил только в worker-процессе, которого
# там нет, а free-worker вдобавок засыпает через 15 минут. Webhook решает и то,
# и другое — входящий запрос Telegram будит уснувший сервис.
# PUBLIC_API_URL — публичный адрес API без слэша в конце.
# TELEGRAM_WEBHOOK_SECRET — минимум 24 символа: openssl rand -hex 24
PUBLIC_API_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Due-soon reminder ---
DUE_SOON_REMINDER_DAYS=2

# --- Seeds ---
SEED_MAIN_ADMIN_PHONE=+998900000000
SEED_MAIN_ADMIN_PASSWORD=ChangeMe123!

# --- Аналитика сайта levelup-academy.uz (Main Admin -> Аналитика сайта) ---
# Сервисный аккаунт Google: читает GA4 Data API и Search Console API.
# Как получить — docs/SITE-ANALYTICS.md. Пусто -> страница показывает
# инструкцию по настройке, остальная панель работает как обычно.
# GOOGLE_SA_PRIVATE_KEY: значение из JSON целиком, включая -----BEGIN...-----,
# переводы строк оставить как литеральные \n в одной строке.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Числовой ID ресурса GA4 (не Measurement ID G-XXXX)
GA4_PROPERTY_ID=
# domain-property: sc-domain:levelup-academy.uz | префиксный: https://levelup-academy.uz/
GSC_SITE_URL=sc-domain:levelup-academy.uz

# --- Лимиты хранилища (Main Admin -> Здоровье системы) ---
# Ни у Neon, ни у Storj нет подключённого сюда API биллинга — сервер видит
# только реальный объём, лимит плана знаете только вы. Пусто -> страница
# показывает объём без процента "сколько из лимита".
# Neon Free (проверьте в своём дашборде, лимиты меняются): обычно ~0.5 GB
NEON_STORAGE_LIMIT_GB=
# Storj не блокирует по факту (платите по использованию) — это ваш
# собственный бюджетный порог для предупреждения, не техническое ограничение
STORJ_STORAGE_LIMIT_GB=
