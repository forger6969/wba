# ------------------------------------------------------------
# Supabase — Project Settings → API bo'limidan olinadi
# ------------------------------------------------------------

# Loyiha manzili, masalan: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" kaliti — brauzerga tushadi, bu normal.
# Uni RLS himoya qiladi.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" kaliti — RLS'ni chetlab o'tadi.
# HECH QACHON brauzerga tushmasligi kerak. Faqat server va skriptlarda.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Sayt
# ------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Google Sheets — faqat ko'chirish va sinxronizatsiya skriptlari uchun
# ------------------------------------------------------------

# Students_wba jadvalining ID'si (URL'dagi /d/<ID>/edit qismi)
SHEETS_ID=1IVMxNS6UuIPOrH2EkX7plPCAQlqPZHEr6-Odyl9t2Ng

# Service account JSON fayli yo'li (repo'ga QO'SHILMAYDI)
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/google-service-account.json

# ------------------------------------------------------------
# Telegram (Faza 6)
# ------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
